# Copy to .env and fill in. Never commit .env.
# All *server-only* vars: read only inside createServerFn handlers or /api routes.

# --- Supabase ---
# Server-only (service-role; bypasses RLS — never expose)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role...

# Client-safe (used by the browser via import.meta.env)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...anon...

# --- AI providers (server-only) ---
# Groq key pool (openai/gpt-oss-120b). Up to 3 keys, round-robined with
# automatic cooldown + rotation on rate limits or failures.
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...
# Legacy single key — still honoured and appended to the pool.
# GROQ_API_KEY=gsk_...

# Gemini (gemini-2.5-flash). Used as the fallback provider AND as the
# grounded web-search agent for live data (salaries, market/company news).
GEMINI_API_KEY=AIza...

# --- Session (auto-provisioned by Lovable if you don't set) ---
# SESSION_SECRET=<64+ char random>
