# Copy to .env (local) — never commit .env.
# In production these are Supabase / hosting project secrets.
# All unprefixed vars are SERVER-ONLY: read them inside createServerFn
# handlers or /api route handlers via src/lib/env.server.ts.

# --- Supabase (server-only; service role bypasses RLS) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role...

# --- Supabase (client-safe) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...anon...

# --- AI (server-only) ---
# Gemini is the PRIMARY model for every generation (assistant, resume,
# cover letter, interview, job parsing, matching) and the grounded
# web-search agent used for live job/salary data.
GEMINI_API_KEY=AIza...

# Optional Groq failover pool (openai/gpt-oss-120b). Up to 3 keys,
# round-robined with cooldown + rotation on rate limits or failures.
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...

# --- Session cookie signing (64+ random chars) ---
SESSION_SECRET=
